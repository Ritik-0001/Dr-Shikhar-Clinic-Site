# Public URL of the deployed site (no trailing slash). Used for canonical URLs, the sitemap,
# Open Graph tags and structured data. Set this in your hosting dashboard (e.g. Vercel) too.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ---- Admin panel (/admin) ----
# Password for signing in to /admin. If empty, the built-in password "admin123" is used. Set this in the
# Vercel dashboard (never commit it) before connecting real storage.
ADMIN_PASSWORD=
# Optional: a long random string used to sign the login cookie. Defaults to a value derived from the password.
ADMIN_SECRET=
# Photos and posts are stored on Vercel Blob in production: create a Blob store (Public) in the Vercel
# dashboard and connect it to the project, and this variable is added for you automatically.
# Locally the panel saves to the ".data" folder instead, so leave it empty.
BLOB_READ_WRITE_TOKEN=
